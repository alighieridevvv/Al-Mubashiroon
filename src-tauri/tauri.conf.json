{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "المبشرين",
  "version": "0.1.0",
  "identifier": "com.almubashshireen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "المبشرين — The Bearers of Good News",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}